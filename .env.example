# -----------------------------------------------------------------------------
# Monarch MCP Server - environment configuration
# Copy to .env and fill in. NEVER commit your real .env.
# -----------------------------------------------------------------------------

# -- Transport ----------------------------------------------------------------
# stdio = local single-user (Claude Desktop/Code).  http = self-hosted multi-user
# web service (default in the container).
TRANSPORT=http
PORT=8000
# Loopback host port published by docker-compose (host reverse proxy targets it).
HOST_PORT=8000
HOST=0.0.0.0
# MCP endpoint path. "/" is the web UI, so the connector URL is PUBLIC_URL + this.
MCP_PATH=/mcp
# Per-IP requests/minute (0 disables). /healthz is exempt.
RATE_LIMIT_PER_MINUTE=120

# -- Identity (built-in; no external IdP) ----------------------------------------
# Public HTTPS origin of this server. REQUIRED. It is the OAuth issuer, so it must
# be https:// (http://localhost is accepted for local dev only).
PUBLIC_URL=https://monarch-mcp.example.com
# Encrypts every user's stored Monarch credentials. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Back it up: losing it forces everyone to reconnect Monarch.
SECRET_KEY=
# false: only the first account (admin) can register. true: open registration.
ALLOW_SIGNUP=false
# SQLite database (+ generated key file if SECRET_KEY is unset). Mount a volume.
DATA_DIR=/data

# Scopes granted to connectors. Reads need the read scope; mutating tools also
# need the write scope.
REQUIRED_READ_SCOPE=monarch:read
REQUIRED_WRITE_SCOPE=monarch:write

# Connector token lifetimes (seconds). Defaults: access 7 days, refresh 1 year,
# sliding (each refresh issues a fresh refresh token). Raise to stay signed in longer.
#ACCESS_TOKEN_TTL_SECONDS=604800
#REFRESH_TOKEN_TTL_SECONDS=31536000

# -- Security -----------------------------------------------------------------
# true  = mutating tools are not registered at all (safe default).
# false = mutating tools available, gated by the write scope.
READ_ONLY=true

# -- stdio mode only ----------------------------------------------------------
# Single-user headless login (ignored when TRANSPORT=http; users connect Monarch
# on the web dashboard instead).
MONARCH_EMAIL=
MONARCH_PASSWORD=
MONARCH_MFA_SECRET=
SESSION_STORE_PATH=
